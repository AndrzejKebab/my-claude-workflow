#!/usr/bin/env bash
# Copy an explicitly configured agent transcript directory to an rclone remote.
set -euo pipefail

REMOTE="${AGENT_BACKUP_REMOTE:-${CC_BACKUP_REMOTE:-}}"
SRC="${AGENT_BACKUP_SOURCE:-${CC_BACKUP_SRC:-}}"
LOG="${AGENT_BACKUP_LOG:-${CC_BACKUP_LOG:-}}"
SETTLE="${AGENT_BACKUP_SETTLE:-${CC_BACKUP_SETTLE:-15m}}"

if [[ -z "$SRC" || -z "$REMOTE" ]]; then
    echo "Set AGENT_BACKUP_SOURCE and AGENT_BACKUP_REMOTE before running this command." >&2
    echo "Example remote: encrypted-remote:agent-transcripts" >&2
    exit 2
fi

if ! command -v rclone >/dev/null; then
    echo "rclone is not installed or is not on PATH." >&2
    exit 1
fi

if ! rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:$"; then
    echo "rclone remote '${REMOTE%%:*}' is not configured. Run: rclone config" >&2
    exit 1
fi

[[ -d "$SRC" ]] || { echo "No such transcript source: $SRC" >&2; exit 1; }

log_args=()
[[ -z "$LOG" ]] || log_args=(--log-file "$LOG" --log-level INFO)

exec rclone copy "$SRC" "$REMOTE" \
    --min-age "$SETTLE" \
    --transfers 4 \
    --checkers 8 \
    --retries 5 \
    --low-level-retries 20 \
    --stats 5m \
    --stats-one-line \
    "${log_args[@]}" \
    "$@"
