#!/usr/bin/env bash
# unity-recompile — batchmode compile-check.
#
# DEPRECATED in name only. The old behavior (focus a live editor via hyprctl,
# poke it with `unity-cli editor refresh`, sleep for domain reload) is gone:
# agentic Unity work can't assume a live editor.
#
# What this does now:
#   unity-recompile <project-path>
#     1. Removes any stale Temp/UnityLockfile from the target project.
#     2. Runs Unity in batchmode against the project — Unity imports + compiles
#        every assembly, then quits.
#     3. Prints a summary: exit code, error CS count, and the first compile
#        error lines if any.
#
# If you need to compile-check against multiple Unity versions, run this for
# each project in parallel — they have independent Library/Temp dirs.

set -uo pipefail

if [[ -z "${1:-}" ]]; then
    echo "Usage: unity-recompile <project-path>" >&2
    exit 1
fi

PROJECT_PATH="$1"
LOG=$(mktemp -t unity-recompile.XXXXXX.log)

rm -f "$PROJECT_PATH/Temp/UnityLockfile"

unity "$PROJECT_PATH" -batchmode -nographics -quit -logFile - > "$LOG" 2>&1
exit_code=$?

err_count=$(grep -c 'error CS' "$LOG" || true)
warn_count=$(grep -c 'warning CS' "$LOG" || true)

echo "unity exit: $exit_code"
echo "error CS:   $err_count"
echo "warning CS: $warn_count"
echo "log:        $LOG"

if [[ $err_count -gt 0 ]]; then
    echo
    echo "First compile errors:"
    grep 'error CS' "$LOG" | sort -u | head -10
fi

# Map Unity's exit code to ours, but also fail if we found compile errors even
# when Unity itself somehow returned 0 (it usually doesn't, but pipelines).
if [[ $exit_code -ne 0 || $err_count -gt 0 ]]; then
    exit 1
fi
exit 0
