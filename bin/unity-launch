#!/bin/bash
# Unity Editor launcher with GTK drag-and-drop crash fix
# Fixes: SIGSEGV in gdk_drag_begin_from_point when dragging in editor
# Works around dead drag windows and crash-on-second-drag on XWayland/Hyprland

UNITY_DND_FIX="/home/midori/.local/lib/unity-fixes/unity-dnd-fix.so"

# Find the Unity binary - use first arg or auto-detect
if [[ -n "$1" && -x "$1" ]]; then
    UNITY_BIN="$1"
    shift
else
    # Auto-detect latest installed Unity
    UNITY_BIN=$(ls -1d /home/midori/Unity/Hub/Editor/*/Editor/Unity 2>/dev/null | sort -V | tail -1)
fi

if [[ ! -x "$UNITY_BIN" ]]; then
    echo "Error: Unity binary not found" >&2
    exit 1
fi

echo "[unity-launch] Binary: $UNITY_BIN"
echo "[unity-launch] DnD fix: $UNITY_DND_FIX"

# Prepend our fix to any existing LD_PRELOAD
if [[ -n "$LD_PRELOAD" ]]; then
    export LD_PRELOAD="$UNITY_DND_FIX:$LD_PRELOAD"
else
    export LD_PRELOAD="$UNITY_DND_FIX"
fi

# Optional: set UNITY_DND_FIX_VERBOSE=1 for debug output
# export UNITY_DND_FIX_VERBOSE=1

exec "$UNITY_BIN" "$@"
