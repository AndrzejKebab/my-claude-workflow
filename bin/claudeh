#!/usr/bin/env bash
# Launch Claude Code through an optional local Headroom proxy.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${HEADROOM_PORT:-8787}"
BASE="http://127.0.0.1:${PORT}"

resolve_headroom() {
    if [[ -n "${HEADROOM_BIN:-}" ]]; then printf '%s\n' "$HEADROOM_BIN"; return; fi
    command -v headroom 2>/dev/null && return
    [[ -x "$HOME/.local/bin/headroom.exe" ]] && printf '%s\n' "$HOME/.local/bin/headroom.exe" && return
    [[ -x "$HOME/.local/bin/headroom" ]] && printf '%s\n' "$HOME/.local/bin/headroom"
}

HEADROOM="$(resolve_headroom || true)"
if [[ -z "$HEADROOM" || ( ! -x "$HEADROOM" && -z "$(command -v "$HEADROOM" 2>/dev/null || true)" ) ]]; then
    echo "claudeh: Headroom not found. Install it or set HEADROOM_BIN." >&2
    exit 127
fi

temp_root="${TMPDIR:-${TEMP:-/tmp}}"
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) temp_root="$(cygpath -u "$temp_root")" ;;
esac
mkdir -p "$temp_root"
LOG="${HEADROOM_LOG:-$temp_root/headroom-proxy.log}"

ready() { curl -fsS "${BASE}/readyz" >/dev/null 2>&1; }
started_proxy=0
if ! ready; then
    "$HEADROOM" proxy --port "$PORT" >"$LOG" 2>&1 &
    PROXY_PID=$!
    started_proxy=1
    for ((attempt = 1; attempt <= 120; attempt++)); do
        ready && break
        if ! kill -0 "$PROXY_PID" 2>/dev/null; then
            echo "claudeh: Headroom exited during startup; see $LOG" >&2
            exit 1
        fi
        sleep 1
    done
    if ! ready; then
        echo "claudeh: Headroom was not ready after 120 seconds; see $LOG" >&2
        kill "$PROXY_PID" 2>/dev/null || true
        exit 1
    fi
fi

cleanup() {
    if (( started_proxy )); then kill "${PROXY_PID:-}" 2>/dev/null || true; fi
}
trap cleanup EXIT INT TERM

ANTHROPIC_BASE_URL="$BASE" "$SCRIPT_DIR/claude" "$@"
