#!/usr/bin/env bash
# List Unity Editor processes as: <pid><tab><project-path>.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QUIET=0
if [[ "${1:-}" == "-q" ]]; then
    QUIET=1
    shift
fi
FILTER="${1:-}"

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        PS_SCRIPT="$(cygpath -w "$SCRIPT_DIR/unity-processes.ps1")"
        args=(-NoProfile -ExecutionPolicy Bypass -File "$PS_SCRIPT")
        [[ -z "$FILTER" ]] || args+=(-Filter "$FILTER")
        (( QUIET == 0 )) || args+=(-Quiet)
        powershell.exe "${args[@]}"
        ;;
    *)
        found=1
        while read -r pid args; do
            [[ -n "$pid" ]] || continue
            project="$(printf '%s\n' "$args" | sed -nE 's/.*-[Pp]roject[Pp]ath[[:space:]]+"?([^" ]+).*/\1/p')"
            [[ -n "$project" ]] || continue
            [[ -z "$FILTER" || "$project" == *"$FILTER"* ]] || continue
            found=0
            (( QUIET == 1 )) || printf '%s\t%s\n' "$pid" "$project"
        done < <(pgrep -x Unity -a 2>/dev/null || true)
        exit "$found"
        ;;
esac
