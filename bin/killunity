#!/usr/bin/env bash
# Preview or force-stop Unity Editors matching one project path/filter.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ $# -lt 1 ]]; then
    echo "Usage: killunity <project-path-or-filter> [--force]" >&2
    echo "Without --force this command only previews matching editors." >&2
    exit 2
fi

FILTER="$1"
FORCE="${2:-}"
if ! "$SCRIPT_DIR/unity-ps" "$FILTER"; then
    echo "No matching Unity Editor process found."
    exit 0
fi

if [[ "$FORCE" != "--force" ]]; then
    echo "Preview only. Re-run with --force to stop these editors; unsaved work may be lost."
    exit 0
fi

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        PS_SCRIPT="$(cygpath -w "$SCRIPT_DIR/unity-processes.ps1")"
        powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PS_SCRIPT" -Filter "$FILTER" -Terminate
        ;;
    *)
        while read -r pid _; do
            [[ -n "$pid" ]] || continue
            kill -TERM "$pid"
            echo "Stopped Unity process $pid"
        done < <("$SCRIPT_DIR/unity-ps" "$FILTER")
        ;;
esac
