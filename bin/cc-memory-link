#!/usr/bin/env bash
# Make Claude Code's per-project memories durable by moving them into this repo
# and symlinking them back.
#
# Why: memories live in ~/.claude/projects/<slug>/memory/. Nothing tracks
# ~/.claude — not git, not the installer — so every memory ever written is one
# machine rebuild from gone. At the time this was written that was 33 project
# dirs and ~470 files.
#
# The shape mirrors what install.sh already does for skills/ and agents/: the
# real files live here, a symlink points at them from ~/.claude.
#
#   ~/.claude/projects/<slug>/memory  ->  <repo>/memory/<slug>/
#
# Safety: this COPIES first, verifies, and only then replaces the original with
# a link. An interrupted run leaves the originals intact. A name that exists on
# both sides with DIFFERENT content is never overwritten — it is reported and
# skipped, and that slug is left unlinked for you to resolve by hand.
#
# Usage:
#   cc-memory-link -n     # dry run: say what would happen, touch nothing
#   cc-memory-link        # do it
#   cc-memory-link -n <substring>   # limit to slugs matching a substring

set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STORE="$REPO/memory"
PROJECTS="$HOME/.claude/projects"

dry=0
if [[ ${1-} == "-n" || ${1-} == "--dry-run" ]]; then dry=1; shift; fi
filter="${1-}"

linked=0 already=0 conflicted=0 empty=0
say() { printf '%s\n' "$*"; }

[[ -d $PROJECTS ]] || { say "no $PROJECTS — nothing to do"; exit 0; }

for mem in "$PROJECTS"/*/memory; do
	[[ -e $mem ]] || continue
	slug=$(basename "$(dirname "$mem")")
	[[ -n $filter && $slug != *"$filter"* ]] && continue

	if [[ -L $mem ]]; then
		(( already++ )); continue
	fi
	[[ -d $mem ]] || continue

	count=$(find "$mem" -type f | wc -l)
	if (( count == 0 )); then
		(( empty++ )); continue
	fi

	target="$STORE/$slug"

	# Refuse to merge over anything whose content differs.
	clash=""
	if [[ -d $target ]]; then
		while IFS= read -r f; do
			rel="${f#$mem/}"
			[[ -f "$target/$rel" ]] || continue
			cmp -s "$f" "$target/$rel" || clash+="    differs: $rel"$'\n'
		done < <(find "$mem" -type f)
	fi
	if [[ -n $clash ]]; then
		say "CONFLICT  $slug — left alone, resolve by hand:"
		printf '%s' "$clash"
		(( conflicted++ )); continue
	fi

	if (( dry )); then
		say "would link  $slug  ($count files)"
		(( linked++ )); continue
	fi

	mkdir -p "$target" || { say "FAILED mkdir $target"; continue; }
	cp -an "$mem/." "$target/" || { say "FAILED copy $slug"; continue; }

	# Verify every source file arrived byte-identical before removing anything.
	bad=0
	while IFS= read -r f; do
		cmp -s "$f" "$target/${f#$mem/}" || { bad=1; break; }
	done < <(find "$mem" -type f)
	if (( bad )); then
		say "FAILED verify $slug — originals left in place"
		continue
	fi

	rm -rf "$mem" && ln -s "$target" "$mem" || { say "FAILED link $slug"; continue; }
	say "linked    $slug  ($count files)"
	(( linked++ ))
done

say ""
if (( dry )); then
	say "dry run: $linked would be linked, $already already linked, $conflicted conflicted, $empty empty"
	say "run without -n to apply"
else
	say "linked $linked, already linked $already, conflicted $conflicted, empty $empty"
	say "store: $STORE  — commit it to make them durable"
fi
