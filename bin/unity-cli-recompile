#!/usr/bin/env bash
# Recompile through a connected Unity Editor using the Unity CLI.

set -euo pipefail

PROJECT_PATH="${1:-${UNITY_PROJECT_PATH:-}}"
if [[ -z "$PROJECT_PATH" ]]; then
    echo "Usage: unity-cli-recompile <project-path>" >&2
    echo "Alternatively set UNITY_PROJECT_PATH." >&2
    exit 2
fi

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        local_app_data="${LOCALAPPDATA:-}"
        [[ -z "$local_app_data" ]] || local_app_data="$(cygpath -u "$local_app_data")"
        UNITY_CLI="${UNITY_CLI_BIN:-$local_app_data/Unity/bin/unity.exe}"
        ;;
    *) UNITY_CLI="${UNITY_CLI_BIN:-unity}" ;;
esac

if ! command -v "$UNITY_CLI" >/dev/null 2>&1 && [[ ! -x "$UNITY_CLI" ]]; then
    echo "Unity CLI not found. Set UNITY_CLI_BIN to its executable." >&2
    exit 1
fi

echo "Requesting script recompile: $PROJECT_PATH"
"$UNITY_CLI" command recompile --project-path "$PROJECT_PATH" --no-banner --no-color

echo "Recompile status:"
"$UNITY_CLI" command recompile_status --project-path "$PROJECT_PATH" --no-banner --no-color

echo "Recent compiler errors:"
"$UNITY_CLI" command console --project-path "$PROJECT_PATH" --no-banner --no-color -- --tail 5 --level error || true
