#!/usr/bin/env bash
# Launch the Unity Editor version required by a project.

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: unity-editor <project-path> [Unity arguments...]" >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_INPUT="$1"
shift

if [[ ! -d "$PROJECT_INPUT" ]]; then
    echo "Project directory not found: $PROJECT_INPUT" >&2
    exit 1
fi

PROJECT_PATH_UNIX="$(cd "$PROJECT_INPUT" && pwd -P)"
PROJECT_PATH="$PROJECT_PATH_UNIX"
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) PROJECT_PATH="$(cygpath -w "$PROJECT_PATH_UNIX")" ;;
esac
VERSION_FILE="$PROJECT_PATH_UNIX/ProjectSettings/ProjectVersion.txt"
if [[ ! -f "$VERSION_FILE" ]]; then
    echo "Unity version file not found: $VERSION_FILE" >&2
    exit 1
fi

VERSION="$(sed -n 's/^m_EditorVersion:[[:space:]]*//p' "$VERSION_FILE" | head -n 1 | tr -d '\r')"
if [[ -z "$VERSION" ]]; then
    echo "Could not read m_EditorVersion from $VERSION_FILE" >&2
    exit 1
fi

resolve_unity_cli() {
    if [[ -n "${UNITY_CLI_BIN:-}" && -x "${UNITY_CLI_BIN}" ]]; then
        printf '%s\n' "$UNITY_CLI_BIN"
        return
    fi
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            local_app_data="${LOCALAPPDATA:-}"
            [[ -z "$local_app_data" ]] || local_app_data="$(cygpath -u "$local_app_data")"
            candidate="$local_app_data/Unity/bin/unity.exe"
            ;;
        *) candidate="" ;;
    esac
    [[ -n "$candidate" && -x "$candidate" ]] && printf '%s\n' "$candidate"
}

UNITY_CLI="$(resolve_unity_cli || true)"
EDITOR_INSTALL=""
if [[ -n "$UNITY_CLI" ]]; then
    EDITOR_INSTALL="$($UNITY_CLI editors path "$VERSION" --no-banner --no-color 2>/dev/null | tail -n 1 | tr -d '\r')"
fi

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        UNITY_EDITOR_ROOT="${UNITY_EDITOR_ROOT:-F:/Unity Editors}"
        [[ -n "$EDITOR_INSTALL" ]] || EDITOR_INSTALL="$UNITY_EDITOR_ROOT/$VERSION"
        UNITY_EDITOR="$EDITOR_INSTALL/Editor/Unity.exe"
        ;;
    Darwin*)
        UNITY_EDITOR_ROOT="${UNITY_EDITOR_ROOT:-/Applications/Unity/Hub/Editor}"
        [[ -n "$EDITOR_INSTALL" ]] || EDITOR_INSTALL="$UNITY_EDITOR_ROOT/$VERSION"
        UNITY_EDITOR="$EDITOR_INSTALL/Unity.app/Contents/MacOS/Unity"
        ;;
    *)
        UNITY_EDITOR_ROOT="${UNITY_EDITOR_ROOT:-${HOME}/Unity/Hub/Editor}"
        [[ -n "$EDITOR_INSTALL" ]] || EDITOR_INSTALL="$UNITY_EDITOR_ROOT/$VERSION"
        UNITY_EDITOR="$EDITOR_INSTALL/Editor/Unity"
        ;;
esac

if [[ ! -f "$UNITY_EDITOR" ]]; then
    echo "Unity $VERSION was not found at: $UNITY_EDITOR" >&2
    echo "Set UNITY_CLI_BIN or UNITY_EDITOR_ROOT if editors are stored elsewhere." >&2
    exit 1
fi

BATCHMODE=0
for arg in "$@"; do
    if [[ "${arg,,}" == "-batchmode" ]]; then
        BATCHMODE=1
        break
    fi
done

if (( BATCHMODE )); then
    echo "[unity-editor] Unity $VERSION batch mode: $PROJECT_PATH"
    exec "$UNITY_EDITOR" -projectPath "$PROJECT_PATH" "$@"
fi

if "$SCRIPT_DIR/unity-ps" -q "$PROJECT_PATH"; then
    echo "Unity is already running for this project: $PROJECT_PATH" >&2
    echo "Use unity-ps to inspect the matching process." >&2
    exit 1
fi

"$UNITY_EDITOR" -projectPath "$PROJECT_PATH" "$@" >/dev/null 2>&1 &
disown 2>/dev/null || true
echo "Launched Unity $VERSION for: $PROJECT_PATH"
